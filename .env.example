# Environment variables for Next.js Presenton

# Database
DATABASE_URL="file:./dev.db"

# LLM Configuration
LLM="openai" # Options: openai, google, anthropic, ollama, custom
CAN_CHANGE_KEYS="true"

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4"

# Google Gemini
GOOGLE_API_KEY=""
GOOGLE_MODEL="models/gemini-2.0-flash-exp"

# Anthropic Claude
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Ollama
OLLAMA_URL="http://localhost:11434"
OLLAMA_MODEL=""

# Custom OpenAI-Compatible API
CUSTOM_LLM_URL=""
CUSTOM_LLM_API_KEY=""
CUSTOM_MODEL=""
TOOL_CALLS="false"
DISABLE_THINKING="false"
EXTENDED_REASONING="false"
WEB_GROUNDING="false"
USE_CUSTOM_URL="false"

# Image Generation
DISABLE_IMAGE_GENERATION="false"
IMAGE_PROVIDER="dall-e-3" # Options: dall-e-3, gemini_flash, pexels, pixabay
PEXELS_API_KEY=""
PIXABAY_API_KEY=""

# Telemetry
DISABLE_ANONYMOUS_TELEMETRY="false"

# App Data Directory
APP_DATA_DIRECTORY="./app_data"
