// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Presentation {
  id                       String    @id @default(uuid())
  content                  String
  nSlides                  Int       @map("n_slides")
  language                 String
  title                    String?
  filePaths                String?   @map("file_paths") // JSON string
  outlines                 String?   @map("outlines") // JSON string
  createdAt                DateTime  @default(now()) @map("created_at")
  updatedAt                DateTime  @updatedAt @map("updated_at")
  layout                   String?   @map("layout") // JSON string
  structure                String?   @map("structure") // JSON string
  instructions             String?
  tone                     String?
  verbosity                String?
  includeTableOfContents   Boolean   @default(false) @map("include_table_of_contents")
  includeTitleSlide        Boolean   @default(true) @map("include_title_slide")
  webSearch                Boolean   @default(false) @map("web_search")
  
  slides                   Slide[]

  @@map("presentations")
}

model Slide {
  id                String        @id @default(uuid())
  presentationId    String        @map("presentation_id")
  layoutGroup       String        @map("layout_group")
  layout            String
  index             Int
  speakerNote       String?       @map("speaker_note")
  content           String        // JSON string
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  
  presentation      Presentation  @relation(fields: [presentationId], references: [id], onDelete: Cascade)

  @@map("slides")
}

model Template {
  id                String    @id @default(uuid())
  name              String
  description       String?
  layout            String    // JSON string
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("templates")
}

model ImageAsset {
  id                String    @id @default(uuid())
  url               String
  prompt            String?
  provider          String?
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("image_assets")
}

model KeyValue {
  key               String    @id
  value             String
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("key_value")
}
